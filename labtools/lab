#!/usr/bin/env bash
# lab - helper tool for the CPTR 211 Linux labs
#
#   lab check <1-9|all>   check your work for a lab
#   lab break             (Lab 9) break the server for the troubleshooting challenge
#   lab hint <1-6> [more] (Lab 9) get a hint for a help desk ticket
#   lab unbreak           undo everything "lab break" did (instructor escape hatch)
#   lab update            download the newest version of this tool
#   lab version           show the version
#
# Students: you do not need to read or change this file.

LAB_VERSION="1.0"
COURSE_URL="https://raw.githubusercontent.com/abuach/cptr211-linux/main/labtools"
STATE_DIR="/var/lib/cptr211"

# ---------------------------------------------------------------- output helpers

if [[ -t 1 ]]; then
    GREEN=$'\e[32m'; RED=$'\e[31m'; YELLOW=$'\e[33m'; BOLD=$'\e[1m'; DIM=$'\e[2m'; RESET=$'\e[0m'
else
    GREEN=""; RED=""; YELLOW=""; BOLD=""; DIM=""; RESET=""
fi

PASS_COUNT=0
FAIL_COUNT=0
WARN_COUNT=0

pass() {
    echo "  ${GREEN}✔ PASS${RESET}  $1"
    PASS_COUNT=$((PASS_COUNT + 1))
}

fail() {
    echo "  ${RED}✘ FAIL${RESET}  $1"
    [[ -n "$2" ]] && echo "          ${DIM}↳ Hint: $2${RESET}"
    FAIL_COUNT=$((FAIL_COUNT + 1))
}

warn() {
    echo "  ${YELLOW}! NOTE${RESET}  $1"
    [[ -n "$2" ]] && echo "          ${DIM}↳ $2${RESET}"
    WARN_COUNT=$((WARN_COUNT + 1))
}

section() {
    echo
    echo "${BOLD}$1${RESET}"
}

# check "description" "hint if it fails" 'shell test to run'
check() {
    local desc="$1" hint="$2" test="$3"
    if eval "$test" >/dev/null 2>&1; then
        pass "$desc"
    else
        fail "$desc" "$hint"
    fi
}

# soft_check: same as check, but only prints a note instead of failing
soft_check() {
    local desc="$1" note="$2" test="$3"
    if eval "$test" >/dev/null 2>&1; then
        pass "$desc"
    else
        warn "$desc" "$note"
    fi
}

die() {
    echo "${RED}Error:${RESET} $1" >&2
    exit 1
}

# ---------------------------------------------------------------- small test helpers

pkg_installed()  { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "install ok installed"; }
user_exists()    { id "$1" >/dev/null 2>&1; }
group_exists()   { getent group "$1" >/dev/null 2>&1; }
in_group()       { id -nG "$1" 2>/dev/null | tr ' ' '\n' | grep -qx "$2"; }
mode_is()        { [[ "$(stat -c %a "$1" 2>/dev/null)" == "$2" ]]; }
group_is()       { [[ "$(stat -c %G "$1" 2>/dev/null)" == "$2" ]]; }
owner_is()       { [[ "$(stat -c %U "$1" 2>/dev/null)" == "$2" ]]; }
is_locked()      { [[ "$(passwd -S "$1" 2>/dev/null | awk '{print $2}')" == "L" ]]; }
svc_active()     { systemctl is-active --quiet "$1"; }
svc_enabled()    { systemctl is-enabled --quiet "$1"; }
has_acl()        { getfacl -p "$1" 2>/dev/null | grep -qx "$2"; }
must_change_pw() { chage -l "$1" 2>/dev/null | grep -i "last password change" | grep -qi "must be changed"; }

# An IPv4 address that is not loopback and not a VirtualBox/QEMU NAT address (10.0.2.x),
# i.e. an address the lab computers can reach.
has_host_ip() {
    ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | grep -v '^10\.0\.2\.' | grep -q .
}

host_ip() {
    ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | grep -v '^10\.0\.2\.' | head -1
}

ufw_allows() {
    ufw status 2>/dev/null | grep -Eq "^($1)[[:space:]]+ALLOW"
}

# Everything sshd and cron have logged (auth.log, syslog and the journal)
auth_logs() {
    cat /var/log/auth.log /var/log/auth.log.1 2>/dev/null
    journalctl --no-pager -q -t sshd -t sshd-session 2>/dev/null
    journalctl --no-pager -q -u ssh 2>/dev/null
}

cron_logs() {
    cat /var/log/syslog /var/log/syslog.1 2>/dev/null
    journalctl --no-pager -q -t CRON -t cron 2>/dev/null
}

# ---------------------------------------------------------------- who is the student?

STUDENT="${SUDO_USER:-$USER}"
[[ -z "$STUDENT" || "$STUDENT" == "root" ]] && STUDENT="student"
H="$(getent passwd "$STUDENT" | cut -d: -f6)"
[[ -z "$H" ]] && H="/home/$STUDENT"

need_root() {
    if [[ $EUID -ne 0 ]]; then
        echo "${DIM}(lab needs administrator rights for this — you may be asked for YOUR password)${RESET}"
        exec sudo "$0" "$@"
    fi
}

header() {
    echo "${BOLD}════════════════════════════════════════════════════════════${RESET}"
    echo "${BOLD} CPTR 211 · Linux Lab $1 check${RESET}"
    echo "  Computer: $(hostname)   Student: $STUDENT"
    echo "  Date:     $(date '+%Y-%m-%d %H:%M')   Tool version: $LAB_VERSION"
    echo "${BOLD}════════════════════════════════════════════════════════════${RESET}"
}

summary() {
    local total=$((PASS_COUNT + FAIL_COUNT))
    echo
    echo "${BOLD}────────────────────────────────────────────────────────────${RESET}"
    if [[ $FAIL_COUNT -eq 0 ]]; then
        echo " ${GREEN}${BOLD}All $total checks passed. Nice work!${RESET}"
    else
        echo " ${BOLD}Score: $PASS_COUNT / $total${RESET}   (${RED}$FAIL_COUNT to fix${RESET} — read the hints above)"
    fi
    echo " Take a screenshot of this window for your submission."
    echo "${BOLD}────────────────────────────────────────────────────────────${RESET}"
}

