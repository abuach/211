run_check() {
    local n="$1"
    case "$n" in
        1|2|3|4|5|6|7|8|9)
            header "$n"
            "check_lab$n"
            summary
            ;;
        all)
            header "1-9 (all)"
            for n in 1 2 3 4 5 6 7 8 9; do "check_lab$n"; done
            summary
            ;;
        *)
            die "Which lab? Example:  lab check 3"
            ;;
    esac
}

# ================================================================= LAB 9: BREAK / HINT / UNBREAK

NGINX_SITE=/etc/nginx/sites-available/default

do_break() {
    if [[ -f "$STATE_DIR/broken" && "$1" != "--force" ]]; then
        echo "The server is already broken (since $(cat "$STATE_DIR/broken"))."
        echo "If you really want to break it again, run:  sudo lab break --force"
        exit 1
    fi

    echo "Checking that Labs 3-8 are finished first..."
    local missing=0
    pkg_installed nginx                          || { echo "  ✘ nginx is not installed (Lab 3)"; missing=1; }
    grep -Eq '^\s*root /var/www/html;' "$NGINX_SITE" 2>/dev/null \
                                                 || { echo "  ✘ $NGINX_SITE looks different than expected (Lab 3)"; missing=1; }
    user_exists bob && user_exists alice         || { echo "  ✘ users alice and bob are missing (Lab 4)"; missing=1; }
    in_group alice sales                         || { echo "  ✘ alice is not in sales (Lab 4)"; missing=1; }
    [[ -d /srv/company/hr ]]                     || { echo "  ✘ /srv/company/hr is missing (Lab 5)"; missing=1; }
    [[ -f /usr/local/sbin/backup-company.sh ]]   || { echo "  ✘ the backup script is missing (Lab 8)"; missing=1; }
    if [[ $missing -eq 1 ]]; then
        echo
        die "Finish the labs above first, then run  sudo lab break  again."
    fi

    mkdir -p "$STATE_DIR"
    cp -p "$NGINX_SITE" "$STATE_DIR/nginx-default.orig"

    # Ticket 1: typo in the web server's config file
    sed -i -E '0,/^(\s*)root \/var\/www\/html;/s//\1rooot \/var\/www\/html;/' "$NGINX_SITE"
    systemctl restart nginx >/dev/null 2>&1

    # Ticket 2: bob's account gets locked
    passwd -l bob >/dev/null 2>&1

    # Ticket 3: alice is removed from the sales group
    gpasswd -d alice sales >/dev/null 2>&1

    # Ticket 4: the hr folder's group is changed to root
    chgrp root /srv/company/hr

    # Ticket 5: the backup script loses its execute permission
    chmod a-x /usr/local/sbin/backup-company.sh

    # Ticket 6: a "sync agent" service that eats CPU
    cat > /usr/local/bin/riverbend-sync <<'EOF'
#!/bin/bash
# Riverbend file sync agent
while true; do :; done
EOF
    chmod 755 /usr/local/bin/riverbend-sync
    cat > /etc/systemd/system/riverbend-sync.service <<'EOF'
[Unit]
Description=Riverbend file sync agent
After=network.target

[Service]
ExecStart=/usr/local/bin/riverbend-sync
CPUQuota=60%

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable --now riverbend-sync >/dev/null 2>&1

    date '+%Y-%m-%d %H:%M' > "$STATE_DIR/broken"

    echo
    echo "${RED}${BOLD}  *** Uh oh. Six things just broke on the Riverbend server. ***${RESET}"
    echo
    echo "  The help desk tickets are in Lab 9, Part B."
    echo "  Stuck on a ticket? Run:  lab hint <ticket number>"
    echo "  Check your progress:     lab check 9"
}

do_unbreak() {
    [[ -f "$STATE_DIR/broken" ]] || die "Nothing to undo — 'lab break' has not been run."
    [[ -f "$STATE_DIR/nginx-default.orig" ]] && cp -p "$STATE_DIR/nginx-default.orig" "$NGINX_SITE"
    systemctl restart nginx >/dev/null 2>&1
    passwd -u bob >/dev/null 2>&1
    usermod -aG sales alice
    chgrp hr /srv/company/hr && chmod 2770 /srv/company/hr
    chmod 755 /usr/local/sbin/backup-company.sh
    systemctl disable --now riverbend-sync >/dev/null 2>&1
    rm -f /etc/systemd/system/riverbend-sync.service /usr/local/bin/riverbend-sync
    systemctl daemon-reload
    rm -f "$STATE_DIR/broken"
    echo "Everything 'lab break' changed has been put back."
}

do_hint() {
    local t="$1" more="$2"
    case "$t" in
        1)  echo "Ticket 1 hint: Start with  systemctl status nginx . It's not running — so try to start it and read the error."
            [[ -n "$more" ]] && echo "More: Run  sudo nginx -t . It tells you which config file and which LINE NUMBER has the problem. Open that file with sudo nano, fix the typo, then  sudo systemctl restart nginx" ;;
        2)  echo "Ticket 2 hint: Bob says his password is right. What is the STATUS of his account? Try  sudo passwd -S bob  (look at the 2nd column)."
            [[ -n "$more" ]] && echo "More: 'L' means Locked. You learned to lock AND unlock accounts in Lab 4." ;;
        3)  echo "Ticket 3 hint: Bob can get in but alice can't, so the folder is probably fine. What's different about alice? Try  groups alice  and compare with  groups bob"
            [[ -n "$more" ]] && echo "More: Add her back to the group the same way you did in Lab 4 (remember the -a!)." ;;
        4)  echo "Ticket 4 hint: Everybody in HR is affected, so look at the folder itself:  ls -ld /srv/company/hr"
            [[ -n "$more" ]] && echo "More: Compare it with  ls -ld /srv/company/sales . Which column is wrong? chgrp changes a folder's group." ;;
        5)  echo "Ticket 5 hint: Try running the script yourself:  sudo /usr/local/sbin/backup-company.sh  — what error do you get?"
            [[ -n "$more" ]] && echo "More: 'Permission denied' on a script usually means it lost its x (execute) permission. Look with  ls -l  and fix with chmod." ;;
        6)  echo "Ticket 6 hint: Open  htop  (or top) and look at the CPU% column. What's at the top of the list?"
            [[ -n "$more" ]] && echo "More: Killing the process won't keep it gone — a SERVICE restarts it. Use  systemctl status <PID>  to find which service, then stop AND disable it." ;;
        *)  die "Which ticket? Example:  lab hint 3" ;;
    esac
    [[ -z "$more" ]] && echo "${DIM}(Still stuck? Run:  lab hint $t more)${RESET}"
}

# ================================================================= MAIN

do_update() {
    curl -fsSL "$COURSE_URL/lab" -o /tmp/lab.new || die "Could not download the update. Is the VM online?"
    bash -n /tmp/lab.new || die "The downloaded file is damaged. Try again later."
    install -m 755 /tmp/lab.new /usr/local/bin/lab
    rm -f /tmp/lab.new
    echo "Updated. $(/usr/local/bin/lab version)"
}

usage() {
    cat <<EOF
${BOLD}lab${RESET} — CPTR 211 Linux lab helper (version $LAB_VERSION)

  lab check <1-9>       Check your work for a lab, e.g.  lab check 3
  lab check all         Check every lab at once
  lab break             Lab 9 only: break the server for the troubleshooting challenge
  lab hint <1-6>        Lab 9 only: a hint for a help desk ticket (add "more" for a bigger hint)
  lab update            Download the newest version of this tool
  lab version           Show the version
EOF
}

case "$1" in
    check)    need_root "$@"; run_check "$2" ;;
    break)    need_root "$@"; do_break "$2" ;;
    unbreak)  need_root "$@"; do_unbreak ;;
    hint)     do_hint "$2" "$3" ;;
    update)   need_root "$@"; do_update ;;
    version)  echo "lab version $LAB_VERSION" ;;
    ""|help|-h|--help) usage ;;
    *)        echo "Unknown command: $1"; echo; usage; exit 1 ;;
esac
